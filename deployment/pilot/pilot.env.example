# Copy this file to pilot.env outside source control and replace every value.
# Do not place passwords, certificates, private keys, access tokens or connection strings here.
DOMAINBRIDGE_API_FQDN=api-pilot.example.internal
DOMAINBRIDGE_API_HTTPS_PORT=443
DOMAINBRIDGE_POSTGRES_HOST=postgres-pilot.example.internal
DOMAINBRIDGE_POSTGRES_DATABASE=domainbridge_pilot
DOMAINBRIDGE_POSTGRES_RUNTIME_IDENTITY=domainbridge_runtime
DOMAINBRIDGE_PKI_CLIENT_TEMPLATE=DomainBridge-Agent-mTLS
DOMAINBRIDGE_PKI_ROOT_THUMBPRINT=REPLACE_WITH_TRUSTED_ROOT_THUMBPRINT
DOMAINBRIDGE_PILOT_OU_DN=OU=DomainBridge-Pilot,DC=example,DC=internal
DOMAINBRIDGE_DEPLOYMENT_CHANNEL=Intune
