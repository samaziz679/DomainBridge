<Window x:Class="DomainBridge.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DomainBridge Operations" Height="720" Width="1200" MinHeight="600" MinWidth="980" Background="#0C1531" Foreground="#F1F6FF">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#08112B" Padding="20"><StackPanel><TextBlock Text="DOMAINBRIDGE" FontSize="22" FontWeight="Bold" Foreground="#1DC7FF"/><TextBlock Text="OPERATIONS CENTER" FontSize="10" Foreground="#9EAED0" Margin="0,4,0,28"/>
<ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="#DCE8FF"><ListBoxItem Content="Parc" IsSelected="True"/><ListBoxItem Content="Collections"/><ListBoxItem Content="Déploiements"/><ListBoxItem Content="Bibliothèque"/><ListBoxItem Content="Historique"/><ListBoxItem Content="Migration"/><ListBoxItem Content="Paramètres"/></ListBox></StackPanel></Border>
<Grid Grid.Column="1" Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="SectionTitle" Text="Parc" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="SectionHint" Text="Inventaire des postes et état de conformité" Foreground="#9EAED0" Margin="0,6,0,24"/></StackPanel><Border Grid.Row="1" Background="#14224A" BorderBrush="#263B70" BorderThickness="1" CornerRadius="12" Padding="28"><StackPanel><TextBlock x:Name="PrimaryMessage" Text="Aucun poste remonté pour le moment." FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SecondaryMessage" Text="Installez l’agent sur un poste pilote pour commencer l’inventaire." Foreground="#B8C7E5" Margin="0,12,0,0"/><StackPanel x:Name="MigrationWorkspace" Visibility="Collapsed" Margin="0,22,0,0"><TextBlock Text="Workflow de migration" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Découverte  •  2. Prérequis  •  3. Vague pilote  •  4. Exécution  •  5. Validation / rollback" Foreground="#9EAED0" Margin="0,8,0,14"/><WrapPanel><Button Content="Créer le plan pilote" Click="CreatePilotPlan_Click" Padding="14,7" Margin="0,0,10,0"/><Button Content="Vérifier les prérequis" Click="CheckPrerequisites_Click" Padding="14,7"/></WrapPanel><TextBlock x:Name="MigrationStatus" Foreground="#6CE09A" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></StackPanel></Border></Grid></Grid>
</Window>
