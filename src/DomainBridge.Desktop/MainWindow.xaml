<Window x:Class="DomainBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DomainBridge Operations" Height="720" Width="1200" MinHeight="600" MinWidth="980"
        Background="#0C1531" Foreground="#F1F6FF">
    <Window.Resources>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="#DCE8FF"/><Setter Property="Background" Value="Transparent"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#243967"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1DC7FF"/><Setter Property="Foreground" Value="#07132B"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#08112B" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"><TextBlock Text="DOMAINBRIDGE" FontSize="22" FontWeight="Bold" Foreground="#1DC7FF"/><TextBlock Text="OPERATIONS CENTER" FontSize="10" Foreground="#9EAED0" Margin="0,4,0,28"/></StackPanel>
                <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged" Background="Transparent" BorderThickness="0">
                    <ListBoxItem Content="Parc" IsSelected="True"/><ListBoxItem Content="Collections"/><ListBoxItem Content="Déploiements"/><ListBoxItem Content="Bibliothèque"/><ListBoxItem Content="Historique"/><ListBoxItem Content="Migration"/><ListBoxItem Content="Paramètres"/>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="36">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel><TextBlock x:Name="SectionTitle" Text="Parc" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="SectionHint" Text="Inventaire des postes et état de conformité" Foreground="#9EAED0" Margin="0,6,0,24"/></StackPanel>
            <Border Grid.Row="1" Background="#14224A" BorderBrush="#263B70" BorderThickness="1" CornerRadius="12" Padding="28">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PrimaryMessage" Text="Connexion à l’API locale…" FontSize="21" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,18"><TextBlock x:Name="SecondaryMessage" Foreground="#B8C7E5" VerticalAlignment="Center"/><Button Content="Actualiser" Click="Refresh_Click" Margin="22,0,0,0"/></StackPanel>
                    <Grid Grid.Row="2">
                        <ListView x:Name="OperationsList" Background="#101D3F" BorderBrush="#324A7D" BorderThickness="1">
                            <ListView.View><GridView><GridViewColumn Header="Élément" Width="190" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="État" Width="105" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Détails" Width="350" DisplayMemberBinding="{Binding Detail}"/><GridViewColumn Header="Activité" Width="150" DisplayMemberBinding="{Binding Activity}"/></GridView></ListView.View>
                        </ListView>
                        <StackPanel x:Name="MigrationWorkspace" Visibility="Collapsed"><TextBlock Text="Workflow de migration" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Découverte  •  2. Prérequis  •  3. Vague pilote  •  4. Exécution  •  5. Validation / rollback" Foreground="#9EAED0" Margin="0,8,0,14"/><WrapPanel><Button Content="Créer le plan pilote" Click="CreatePilotPlan_Click" Margin="0,0,10,0"/><Button Content="Vérifier les prérequis" Click="CheckPrerequisites_Click"/></WrapPanel><TextBlock x:Name="MigrationStatus" Foreground="#6CE09A" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
